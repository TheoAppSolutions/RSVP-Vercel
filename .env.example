# Copy this file to .env.local for local development.
# In production, set these as Environment Variables in your Vercel project
# (Project Settings → Environment Variables) instead of committing a real .env file.

# --- Google Sheets integration ---
# The Sheet ID is the long string in the sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# From the service account JSON key file, the "client_email" field.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the service account JSON key file, the "private_key" field.
# Keep the quotes and the literal \n line breaks exactly as they appear
# in the downloaded JSON — do not reformat this value.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
